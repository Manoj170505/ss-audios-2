# SS Audios Frontend Configuration

# Hosted Backend API URL on Render
VITE_API_BASE_URL="https://ss-audios-backend.onrender.com"

# GEMINI_API_KEY: Optional client-side key override
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Provisioned Google Maps Platform browser key.
VITE_GOOGLE_MAPS_API_KEY=""

# ADMIN_PASSCODE: Optional server-side passcode for SS Audios Admin Portal.
ADMIN_PASSCODE=""
